# Endereço público do serviço (sem barra no fim)
BASE_URL=https://bot.mcs.ind.br
PORT=3020
DATA_DIR=/app/data

# Painel
PAINEL_SENHA=troque-esta-senha
# PAINEL_SEGREDO=  (opcional; assina o cookie. Vazio = derivado da senha)

# Leitura por outros sistemas (Gerente IA), cabeçalho x-api-key
BOT_API_KEY=

# App do Mercado Livre (developers.mercadolivre.com.br)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# ML_REDIRECT_URI=  (vazio = BASE_URL/oauth/ml/callback)

# TRAVA DE ENVIO: false = só sugere (enquanto o Gobots responde). true = libera o botão Enviar.
ML_ENVIO_HABILITADO=false

SINCRONIZAR_MINUTOS=5
HISTORICO_MAX=5000

# Texto em volta de toda resposta
RESPOSTA_SAUDACAO=Olá!
RESPOSTA_ASSINATURA=Agradecemos o contato. Equipe MCS.

# IA (Anthropic). Sem a chave, só as respostas prontas geram sugestão.
ANTHROPIC_API_KEY=
# IA_MODELO=  (vazio = escolhe um Sonnet disponível na chave)
