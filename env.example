# Endereço público do serviço (sem barra no fim)
BASE_URL=https://bot.mcs.ind.br
PORT=3020
DATA_DIR=/app/data

# Painel
PAINEL_SENHA=troque-esta-senha
# PAINEL_SEGREDO=  (opcional; assina o cookie. Vazio = derivado da senha)

# Leitura por outros sistemas (Gerente IA), cabeçalho x-api-key
BOT_API_KEY=

# App do Mercado Livre (developers.mercadolivre.com.br)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# ML_REDIRECT_URI=  (vazio = BASE_URL/oauth/ml/callback)

# TRAVA DE ENVIO: false = só sugere (enquanto o Gobots responde). true = libera o botão Enviar.
ML_ENVIO_HABILITADO=false

SINCRONIZAR_MINUTOS=5
HISTORICO_MAX=5000

# Texto em volta de toda resposta
RESPOSTA_SAUDACAO=Olá!
RESPOSTA_ASSINATURA=Atenciosamente, equipe MCS.

# IA: mesmas variáveis do Gerente IA. Sem chave, só as respostas prontas geram sugestão.
# OpenRouter:
OPENROUTER_API_KEY=
# ASSISTENTE_MODELO=  (opcional; vazio = o Claude Sonnet mais novo do catálogo)
# ou Anthropic direto (modelo opcional):
# ANTHROPIC_API_KEY=
# ASSISTENTE_PROVEDOR=  (anthropic | openrouter; vazio = a chave que existir)

# Pendente mais velha que isso (dias) fica na aba "Antigas" e não ganha sugestão automática.
PERGUNTA_ANTIGA_DIAS=30
