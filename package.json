{
  "name": "mcs-bot",
  "version": "0.10.0",
  "description": "Respostas automáticas às perguntas dos marketplaces (começa pelo Mercado Livre). Substitui o Gobots.",
  "main": "dist/index.js",
  "private": true,
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
