    "dotenv": "^16.4.5",
    "fastify": "^4.28.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.1.4"
  },
  "license": "UNLICENSED"
}
